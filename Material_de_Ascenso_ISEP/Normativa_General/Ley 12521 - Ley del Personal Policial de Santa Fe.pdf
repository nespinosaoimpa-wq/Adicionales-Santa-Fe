<div class="row form">
    <form id="form_buscar" method="post">
        <h3>Búsqueda de normativas</h3>


        <div class="row">
            <div class="fourcol last">                   
                <label>Tipo de Norma: </label>
                <select id="tipoNorma" name="tipoNorma" >
                    <option value="1" > Leyes </option>
                    <option value="2" > Decretos </option>
                    <option value="4" > Disposiciones </option>
                    <option value="5" > Resoluciones </option>
                    <option value="6" > Dictámenes </option>
                </select>               
            </div>
        </div>


        <div class="row">
            <div id="campoOrganismo" class="fourcol last" style="display:none">              
                <label>Organismo: </label>
                <select id="organismoSelect" name="organismoSelect">                
                    <!--<option value="">Todos</option>-->
                </select>
            </div>
        </div>





        <div class="row">
            <div class="twocol" style="margin-top: 10px;">
                <label>Número:</label> <input name="numNorma" id="numNorma" type="text"
                                              class="input" placeholder="Número de norma." value="">
            </div>
            <div class="twocol last" style="margin-top: 10px;">
                <label>Año:</label> <input id="anio" name="anio" type="text"
                                           class="input" placeholder="Año de la norma." value="">
            </div>

        </div>
        <div class="ui-widget">
            <div class="ui-state-highlight ui-corner-all"
                 style="margin: 5px; padding: 10px;">
                <p>
                    <span class="ui-icon ui-icon-info"
                          style="float: left; margin-right: .3em;"></span> <strong>Ayuda:</strong>
                    Los ceros iniciales en el número de la norma no son necesarios.
                </p>
            </div>
        </div>
        
         <div class="row">
            <div class="fourcol last" style="margin-top: 10px;">
                <label>Expediente:</label> <input name="numExpediente" id="numExpediente" type="text"
                                              class="input" placeholder="Número de expediente." value="">
            </div>
        </div>

        <div class="row">
            <div class="sixcol">
                <label>Texto:</label>
                <textarea id="textoNorma" name="textoNorma" cols="" rows="" value=""></textarea>
            </div>
            <div class="twocol last">
                <label>Coincidencia: </label>
                <select id="frase" name="frase">
                    <option value = alguna > Alguna palabra </option>
                    <option value = todas > Todas las palabras </option>
                    <option value = exacta > Frase exacta </option>
                </select>
            </div>
        </div>

        <div class="row" id="divTemas">  
            <div class="eightcol last">
                <label>Tema: </label>
                <select multiple size='8' id="tema" name="tema[]"  style="height: auto" >
                </select>  
            </div>

        </div>
        <div class="ui-widget" id="divAyudaTemas">
            <div class="ui-state-highlight ui-corner-all"
                 style="margin: 5px; padding: 10px;">
                <p>
                    <span class="ui-icon ui-icon-info"
                          style="float: left; margin-right: .3em;"></span> <strong>Ayuda:</strong>
                    Puede seleccionar más de un tema utilizando la tecla "Ctrl".
                </p>
            </div>
        </div>



        <div class="row" id="divIniciador">
            <div class="eightcol last">
                <label>Iniciador: </label>
                <select id="iniciador" name="iniciador">
                    <option value="" >Sin especificar</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="fourcol">
                <label>Desde: </label>
                <input type="text" id="fechaDesde" name="fechaDesde" class="input"/>
                <div id="errorFechaDesde" class="help-block with-errors" >
                    <ul class="list-unstyled">
                        <li></li>
                    </ul>
                </div>
            </div> 
            <div class="fourcol last">
                <label>Hasta: </label>
                <input type="text" id="fechaHasta" name="fechaHasta" class="input"/>
                <div id="errorFechaHasta" class="help-block with-errors" >
                    <ul class="list-unstyled">
                        <li></li>
                    </ul>
                </div>
            </div>

        </div>
        <input type="hidden" name="action" value="buscar" id="action"/>
        <input type="hidden" name="pagina" value="1" id="pagina"/>
        <input type="hidden" name="ordenarPor" value="2" id="ordenarPor"/>
        <input type="hidden" name="ordenBusqueda" value="ASC" id="ordenBusqueda"/>

        <div  class="row">
            <button type="submit" name="boton" id="buscar">Buscar</button>
            <button id="registro_boton_limpiar" name="registro_limpiar" class="nowait">Limpiar</button>
            <div class="clear"></div>
        </div> 
    </form>

    <div class="row">
        <div id="results" class="last"></div>
    </div>
